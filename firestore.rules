rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Global Safety Net ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Connection Test ───────────────────────────
    match /nodes/connection-test {
      allow read: if true;
    }

    // ── Helper functions ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        request.auth.token.email == 'vannymwamba@gmail.com'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          request.auth.token.email.lower().endsWith('@urban-hikers.com')
        )
      );
    }

    function isPartner() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/partners/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['partner', 'partner_admin', 'partner_content_editor', 'admin', 'super_admin'])
      );
    }

    // ── admins collection ─────────────────────────
    match /admins/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ── broadcasts collection ─────────────────────
    match /broadcasts/{docId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isPartner();
      allow update: if isSuperAdmin() || (
        isPartner() && 
        (resource.data.published_by == request.auth.uid || 
         resource.data.partner_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId ||
         resource.data.partner_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partner_id)
      );
      allow delete: if isSuperAdmin() || (
        isPartner() && resource.data.published_by == request.auth.uid
      );
    }

    // ── pois collection (Public Art) ──────────────
    match /pois/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── vibe_reports collection ───────────────────
    match /vibe_reports/{docId} {
      allow read: if true;
      allow create: if true; // Anonymous reports allowed
      allow update, delete: if isSuperAdmin();
    }

    // ── taps collection ───────────────────────────
    match /taps/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true; // Anonymous taps allowed
      allow update, delete: if isSuperAdmin();
    }

    // ── tab_views collection ──────────────────────
    match /tab_views/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ── interactions collection ───────────────────
    match /interactions/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ── flash_rotation collection ─────────────────
    match /flash_rotation/{docId} {
      allow read:   if true;
      allow write: if isSuperAdmin();
    }

    // ── impressions collection ────────────────────
    match /impressions/{docId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── nodes / hubs collection ───────────────────
    match /nodes/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── partners collection ───────────────────────
    match /partners/{docId} {
      allow read:   if resource.data.active == true || isAdmin();
      allow write:  if isAdmin();
    }

    // ── walks collection ──────────────────────────
    match /walks/{docId} {
      allow read:   if resource.data.active == true || isAdmin();
      allow write:  if isAdmin();
    }

    // ── routes collection ─────────────────────────
    match /routes/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── sync_logs collection ──────────────────────
    match /sync_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── mail collection (Trigger Email extension) ─
    // Server-side writes only via Admin SDK
    // Client reads own emails only
    match /mail/{docId} {
      allow read:   if isSignedIn() &&
                       resource.data.to == request.auth.token.email;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── signals / civic events ────────────────────
    match /signals/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── local_hubs collection ─────────────────────
    match /local_hubs/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── users / profiles ──────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow write:  if isSignedIn() && request.auth.uid == uid;
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email != null && request.auth.token.email_verified == true && request.auth.token.email == 'vannymwamba@gmail.com')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.keys().hasAll(['email']) && request.auth.token.email != null && request.auth.token.email_verified == true && request.auth.token.email.lower().endsWith('@urban-hikers.com'))
        )
      );
    }

    function isPartner() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/partners/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['partner', 'partner_admin', 'partner_content_editor', 'admin', 'super_admin'])
      );
    }

    // ── admins collection ─────────────────────────
    match /admins/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ── broadcasts collection ─────────────────────
    match /broadcasts/{docId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isPartner();
      allow update: if isSuperAdmin() || (
        isPartner() && 
        (resource.data.published_by == request.auth.uid || 
         resource.data.partner_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId ||
         resource.data.partner_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partner_id)
      );
      allow delete: if isSuperAdmin() || (
        isPartner() && resource.data.published_by == request.auth.uid
      );
    }

    // ── pois collection (Public Art) ──────────────
    match /pois/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── vibe_reports collection ───────────────────
    match /vibe_reports/{docId} {
      allow read: if true;
      allow create: if true; // Anonymous reports allowed
      allow update, delete: if isSuperAdmin();
    }

    // ── taps collection ───────────────────────────
    match /taps/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
                    request.resource.data.verified == false &&
                    request.resource.data.consent_version == 'v1.0' &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.timestamp == request.time &&
                    request.resource.data.keys().hasOnly([
                      'node_id',
                      'artist_id',
                      'uid',
                      'session_uuid',
                      'access_vector',
                      'timestamp',
                      'client_timestamp',
                      'consent_version',
                      'value_score',
                      'tab',
                      'sponsor_id',
                      'walkId',
                      'eventTag',
                      'verified'
                    ]);
      allow update, delete: if false;
    }

    // ── tab_views collection ──────────────────────
    match /tab_views/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── interactions collection ───────────────────
    match /interactions/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── flash_rotation collection ─────────────────
    match /flash_rotation/{docId} {
      allow read:   if true;
      allow write: if isAdmin();
    }

    // ── impressions collection ────────────────────
    match /impressions/{docId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── nodes / hubs collection ───────────────────
    match /nodes/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── partners collection ───────────────────────
    match /partners/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── walks collection ──────────────────────────
    match /walks/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── routes collection ─────────────────────────
    match /routes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── sync_logs collection ──────────────────────
    match /sync_logs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── mail collection (Trigger Email extension) ─
    // Server-side writes only via Admin SDK
    // Client reads own emails only
    match /mail/{docId} {
      allow read:   if isSignedIn() &&
                       resource.data.to == request.auth.token.email;
      allow create, update, delete: if false;
    }

    // ── bookings collection ───────────────────────
    match /bookings/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true; // Allow anonymous booking for now, or isSignedIn()
      allow update, delete: if isAdmin();
    }

    // ── signals / civic events ────────────────────
    match /signals/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── wrap_summaries collection ────────────────
    match /wrap_summaries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── local_hubs collection ─────────────────────
    match /local_hubs/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── artists collection ────────────────────────
    match /artists/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── globalSponsors collection ─────────────────
    match /globalSponsors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── lost_found collection ─────────────────────
    match /lost_found/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolved_by_code']) &&
        request.resource.data.status == 'resolved' &&
        request.resource.data.resolved_by_code == resource.data.resolveCode
      );
      allow delete: if isAdmin();
    }

    // ── node_proposals collection ──────────────────
    match /node_proposals/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
                    request.resource.data.proposed_by_uid == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.created_at == request.time &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 200 &&
                    request.resource.data.reason is string &&
                    request.resource.data.reason.size() > 0 &&
                    request.resource.data.reason.size() <= 2000 &&
                    (request.resource.data.address == null || (request.resource.data.address is string && request.resource.data.address.size() <= 300)) &&
                    (request.resource.data.neighborhood == null || (request.resource.data.neighborhood is string && request.resource.data.neighborhood.size() <= 120)) &&
                    (request.resource.data.latitude == null || request.resource.data.latitude is number) &&
                    (request.resource.data.longitude == null || request.resource.data.longitude is number) &&
                    (request.resource.data.proposed_by_email == null || (request.resource.data.proposed_by_email is string && request.resource.data.proposed_by_email.size() <= 254)) &&
                    request.resource.data.keys().hasOnly([
                      'name',
                      'address',
                      'reason',
                      'latitude',
                      'longitude',
                      'neighborhood',
                      'proposed_by_uid',
                      'proposed_by_email',
                      'status',
                      'created_at'
                    ]);
      allow update, delete: if isAdmin();
    }

    // ── users / profiles ──────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
                    !request.resource.data.keys().hasAny(['role', 'partnerId', 'partner_id']);
      allow update: if isSignedIn() && request.auth.uid == uid &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'partnerId', 'partner_id']);
      allow delete: if false;

      match /pulse_drops/{dateId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isAdmin() &&
                      request.resource.data.read == false &&
                      request.resource.data.created_at == request.time &&
                      request.resource.data.type is string &&
                      request.resource.data.type.size() <= 64 &&
                      request.resource.data.title is string &&
                      request.resource.data.title.size() <= 200 &&
                      request.resource.data.body is string &&
                      request.resource.data.body.size() <= 500 &&
                      request.resource.data.keys().hasOnly([
                        'type',
                        'title',
                        'body',
                        'read',
                        'created_at',
                        'node_id',
                        'proposal_id'
                      ]);
        allow update: if isSignedIn() &&
                      request.auth.uid == uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                      request.resource.data.read is bool;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ── visitor_profiles collection ───────────────
    match /visitor_profiles/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── leaderboard collection ─────────────────────
    // Computed server-side ONLY, by a trusted recompute job running with
    // Admin SDK credentials (which bypass these rules by design) from real
    // visitor_profiles data. No client — not even the doc's own owner — may
    // write here directly; that was the self-reported gaming hole.
    // See src/services/recomputeLeaderboard.ts.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

  }
}


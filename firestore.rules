rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Bootstrapped Admin: vannymwamba@gmail.com
    function isAdmin() {
      // Use simple equality checks first as diag
      return isSignedIn() && (
        request.auth.token.email == 'vannymwamba@gmail.com' || 
        request.auth.token.email == 'Vannymwamba@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    function isPartner(partnerId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerId', '') == partnerId || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partner_id', '') == partnerId)) ||
        (exists(/databases/$(database)/documents/partners/$(partnerId)) &&
         get(/databases/$(database)/documents/partners/$(partnerId)).data.owner_email == request.auth.token.email)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidNode(data) {
      return data.keys().hasAll(['name', 'type', 'latitude', 'longitude', 'radius_limit']) &&
             data.name is string &&
             data.type in ['street', 'conference_center'] &&
             data.latitude is number && data.longitude is number;
    }

    function isValidBroadcast(data) {
      // Loosen temporarily to diagnose
      return data.keys().hasAll(['title', 'type', 'latitude', 'longitude', 'starts_at', 'expires_at', 'current_vibe']) &&
             data.title is string &&
             data.type is string &&
             data.latitude is number && data.longitude is number;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.role in ['admin', 'super_admin', 'partner', 'user', 'partner_admin', 'partner_viewer', 'partner_content_editor'];
    }

    function isValidTap(data) {
      return data.keys().hasAll(['node_id', 'session_uuid', 'timestamp']) &&
             data.node_id is string && data.session_uuid is string &&
             data.timestamp is string;
    }

    // --- Match Groups ---

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && (
        incoming().role == 'user' || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(uid) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'partner_id', 'partnerId']) &&
         incoming().role == existing().role)
      );
    }

    match /nodes/{nodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow list: if true;
      allow create: if isAdmin() || 
                    (isPartner(incoming().get('partner_id', '')) && 
                     isValidBroadcast(incoming()) && 
                     timestamp(incoming().expires_at) > request.time);
      allow update: if isAdmin() || 
                    (isPartner(existing().get('partner_id', '')) && isValidBroadcast(incoming())) ||
                    (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['current_vibe']));
      allow delete: if isAdmin() || isPartner(existing().get('partner_id', ''));
    }

    match /pois/{poiId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /taps/{tapId} {
      allow read: if isAdmin();
      allow create: if true; // Public can log taps anonymously
    }

    match /vibe_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true; // Public can report vibes
    }

    match /tab_views/{viewId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /interactions/{interactionId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /signals/{signalId} {
      allow read: if true;
      allow write: if false; // Strictly server-side via Admin SDK
    }
  }
}

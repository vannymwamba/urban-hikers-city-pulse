rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Global Safety Net ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Connection Test ───────────────────────────
    match /test/{docId} {
      allow read, write: if true;
    }
    match /_connection_test_/{docId} {
      allow read, write: if true;
    }
    match /nodes/connection-test {
      allow read, write: if true;
    }

    // ── Helper functions ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email != null && request.auth.token.email == 'vannymwamba@gmail.com')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.keys().hasAll(['email']) && request.auth.token.email != null && request.auth.token.email.lower().endsWith('@urban-hikers.com'))
        )
      );
    }

    function isPartner() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/partners/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['partner', 'partner_admin', 'partner_content_editor', 'admin', 'super_admin'])
      );
    }

    // ── admins collection ─────────────────────────
    match /admins/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ── broadcasts collection ─────────────────────
    match /broadcasts/{docId} {
      allow read: if true;
      allow create: if isSuperAdmin() || isPartner() || request.resource.data.server_token == 'URBAN_HIKERS_SERVER_SECRET_2026';
      allow update: if isSuperAdmin() || (
        isPartner() && 
        (resource.data.published_by == request.auth.uid || 
         resource.data.partner_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId ||
         resource.data.partner_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partner_id)
      ) || request.resource.data.server_token == 'URBAN_HIKERS_SERVER_SECRET_2026';
      allow delete: if isSuperAdmin() || (
        isPartner() && resource.data.published_by == request.auth.uid
      );
    }

    // ── pois collection (Public Art) ──────────────
    match /pois/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── vibe_reports collection ───────────────────
    match /vibe_reports/{docId} {
      allow read: if true;
      allow create: if true; // Anonymous reports allowed
      allow update, delete: if isSuperAdmin();
    }

    // ── taps collection ───────────────────────────
    match /taps/{docId} {
      allow read: if isAdmin();
      allow create: if true; // Anonymous taps allowed
      allow update, delete: if isAdmin();
    }

    // ── tab_views collection ──────────────────────
    match /tab_views/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── interactions collection ───────────────────
    match /interactions/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── flash_rotation collection ─────────────────
    match /flash_rotation/{docId} {
      allow read:   if true;
      allow write: if isAdmin();
    }

    // ── impressions collection ────────────────────
    match /impressions/{docId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── nodes / hubs collection ───────────────────
    match /nodes/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── partners collection ───────────────────────
    match /partners/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── walks collection ──────────────────────────
    match /walks/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── routes collection ─────────────────────────
    match /routes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── sync_logs collection ──────────────────────
    match /sync_logs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── mail collection (Trigger Email extension) ─
    // Server-side writes only via Admin SDK
    // Client reads own emails only
    match /mail/{docId} {
      allow read:   if isSignedIn() &&
                       resource.data.to == request.auth.token.email;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── bookings collection ───────────────────────
    match /bookings/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true; // Allow anonymous booking for now, or isSignedIn()
      allow update, delete: if isAdmin();
    }

    // ── signals / civic events ────────────────────
    match /signals/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── wrap_summaries collection ────────────────
    match /wrap_summaries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── local_hubs collection ─────────────────────
    match /local_hubs/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── artists collection ────────────────────────
    match /artists/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── globalSponsors collection ─────────────────
    match /globalSponsors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── lost_found collection ─────────────────────
    match /lost_found/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
        request.resource.data.status == 'resolved' &&
        request.resource.data.resolved_by_code == resource.data.resolveCode
      );
      allow delete: if isAdmin();
    }

    // ── users / profiles ──────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow write:  if isSignedIn() && request.auth.uid == uid;

      match /pulse_drops/{dateId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        request.auth.token.email == 'vannymwamba@gmail.com'
      );
    }

    function isPartner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/partners/$(request.auth.uid));
    }

    // ── admins collection ─────────────────────────
    match /admins/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ── broadcasts collection ─────────────────────
    match /broadcasts/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ── pois collection (Public Art) ──────────────
    match /pois/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── vibe_reports collection ───────────────────
    match /vibe_reports/{docId} {
      allow read: if true;
      allow create: if true; // Anonymous reports allowed
      allow update, delete: if isSuperAdmin();
    }

    // ── taps collection ───────────────────────────
    match /taps/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true; // Anonymous taps allowed
      allow update, delete: if isSuperAdmin();
    }

    // ── tab_views collection ──────────────────────
    match /tab_views/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ── interactions collection ───────────────────
    match /interactions/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ── flash_rotation collection ─────────────────
    match /flash_rotation/{docId} {
      allow read:   if true;
      allow write: if isSuperAdmin();
    }

    // ── impressions collection ────────────────────
    match /impressions/{docId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── nodes / hubs collection ───────────────────
    match /nodes/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── partners collection ───────────────────────
    match /partners/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── routes collection ─────────────────────────
    match /routes/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── sync_logs collection ──────────────────────
    match /sync_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── mail collection (Trigger Email extension) ─
    // Server-side writes only via Admin SDK
    // Client reads own emails only
    match /mail/{docId} {
      allow read:   if isSignedIn() &&
                       resource.data.to == request.auth.token.email;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── signals / civic events ────────────────────
    match /signals/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── users / profiles ──────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow write:  if isSignedIn() && request.auth.uid == uid;
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          == 'super_admin';
    }

    function isPartner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/partners/$(request.auth.uid));
    }

    // ── admins collection ─────────────────────────
    // Only the owner can read their own admin doc
    // Only Firebase Console / Admin SDK can write
    match /admins/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── broadcasts collection ─────────────────────
    // Anyone can read (public feed)
    // Super admin can write directly (bypass Stripe)
    // Partners write only through server (Stripe webhook)
    // New fields covered: is_sponsored, sponsor_name,
    //   artist, booking_url, sponsor_logo_url,
    //   rotation_interval_seconds, cross_connection_id,
    //   starts_at, expires_at, event_date
    match /broadcasts/{docId} {
      allow read: if true;

      // Super admin — direct write, all fields allowed
      allow create, update: if isSuperAdmin();

      // Partners — only through server-side webhook
      // (Stripe confirms payment before server writes)
      allow delete: if isSuperAdmin();
    }

    // ── flash_rotation collection ─────────────────
    // Sponsor banner slots — paid via Stripe
    // Super admin can write directly for testing
    match /flash_rotation/{docId} {
      allow read:   if true;
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── impressions collection ────────────────────
    // Analytics — anyone authenticated can write
    // (tap and impression tracking)
    match /impressions/{docId} {
      allow read:   if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── nodes / hubs collection ───────────────────
    match /nodes/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── partners collection ───────────────────────
    match /partners/{docId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── mail collection (Trigger Email extension) ─
    // Server-side writes only via Admin SDK
    // Client reads own emails only
    match /mail/{docId} {
      allow read:   if isSignedIn() &&
                       resource.data.to == request.auth.token.email;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── signals / civic events ────────────────────
    match /signals/{docId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── users / profiles ──────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow write:  if isSignedIn() && request.auth.uid == uid;
    }

  }
}

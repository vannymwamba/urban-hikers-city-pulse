{
  "entities": {
    "Node": {
      "title": "Sector Hub Node",
      "description": "Physical NFC trigger points.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the node" },
        "name": { "type": "string", "description": "Human-readable name of the location" },
        "type": { "type": "string", "enum": ["street", "conference_center"], "description": "Category of the hub" },
        "latitude": { "type": "number", "description": "WGS84 Latitude" },
        "longitude": { "type": "number", "description": "WGS84 Longitude" },
        "radius_limit": { "type": "number", "description": "Radius in meters for broadcasts" },
        "tap_count": { "type": "integer", "description": "Total number of NFC taps recorded" }
      },
      "required": ["id", "name", "type", "latitude", "longitude", "radius_limit"]
    },
    "Partner": {
      "title": "Local Partner",
      "description": "Businesses or organizations providing broadcasts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tier": { "type": "string", "enum": ["standard", "premium", "anchor"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "owner_uid": { "type": "string", "description": "Firebase Auth UID of the partner owner" },
        "owner_email": { "type": "string", "description": "Email address of the partner owner" },
        "logo_url": { "type": "string", "description": "Download URL from Firebase Storage (sponsors/{id}/logo.*)" },
        "brand_color": { "type": "string" },
        "deal_text": { "type": "string" },
        "sponsor_zones": { "type": "array", "items": { "type": "string" } },
        "logo_updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "tier", "latitude", "longitude"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user data with roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "partner", "user", "partner_admin", "partner_viewer", "partner_content_editor"] },
        "name": { "type": "string" },
        "partner_id": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Broadcast": {
      "title": "Live Broadcast",
      "description": "Deals, events, or sessions currently active.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partner_id": { "type": "string", "description": "Optional partner link" },
        "node_id": { "type": "string", "description": "Node where it was ignited (for flash events)" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["flash_deal", "event", "conference_panel", "civic_event", "civic_free", "live_performance"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "starts_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "current_vibe": { "type": "string", "enum": ["chill", "buzzing", "packed"] },
        "active": { "type": "boolean", "description": "Whether the broadcast is currently live" },
        "tip_url": { "type": "string", "description": "Optional digital tip jar URL" }
      },
      "required": ["id", "title", "type", "latitude", "longitude", "starts_at", "expires_at", "current_vibe"]
    },
    "Tap": {
      "title": "Proof of Presence Tap",
      "description": "Analytics for NFC taps.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "node_id": { "type": "string" },
        "session_uuid": { "type": "string" },
        "access_vector": { "type": "string", "enum": ["nfc", "direct", "qr"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "tab": { "type": "string", "enum": ["home", "feed", "explore", "wallet", "profile", "map", "routes"] },
        "sponsor_id": { "type": "string" }
      },
      "required": ["id", "node_id", "session_uuid", "timestamp"]
    },
    "TabView": {
      "title": "Tab Navigation Event",
      "description": "Analytics for tab switches.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session_uuid": { "type": "string" },
        "tab": { "type": "string", "enum": ["home", "feed", "explore", "wallet", "profile", "map", "routes"] },
        "access_vector": { "type": "string", "enum": ["nfc", "direct", "qr"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "sponsor_id": { "type": "string" }
      },
      "required": ["id", "session_uuid", "tab", "timestamp"]
    },
    "Poi": {
      "title": "Point of Interest",
      "description": "Public art, murals, or landmarks.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "artist": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["civic_mural"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "artist", "address", "latitude", "longitude", "imageUrl", "type", "createdAt", "active"]
    },
    "VibeReport": {
      "title": "Crowdsourced Vibe Check",
      "description": "User feedback on event density.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "broadcast_id": { "type": "string" },
        "session_uuid": { "type": "string" },
        "vibe": { "type": "string", "enum": ["chill", "buzzing", "packed"] },
        "reported_at": { "type": "string", "format": "date-time" },
        "access_vector": { "type": "string", "enum": ["nfc", "direct", "qr"] },
        "sponsor_id": { "type": "string" }
      },
      "required": ["id", "broadcast_id", "session_uuid", "vibe", "reported_at"]
    },
    "Interaction": {
      "title": "User Interaction",
      "description": "General user actions like shares or saves.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["wallet_save", "share", "vibe_report", "login", "seed"] },
        "session_uuid": { "type": "string" },
        "access_vector": { "type": "string", "enum": ["nfc", "direct", "qr"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "node_id": { "type": "string" },
        "sponsor_id": { "type": "string" },
        "tab": { "type": "string" }
      },
      "required": ["id", "type", "session_uuid", "access_vector", "timestamp"]
    },
    "Signal": {
      "title": "Civic Pulse Signal",
      "description": "Scraped and enriched civic events.",
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "source_id": { "type": "string" },
        "signal_title": { "type": "string" },
        "signal_vibe": { "type": "string", "enum": ["CHILL", "BUZZING", "PACKED"] },
        "signal_category": { "type": "string", "enum": ["CIVIC_EVENT", "WALKING_EVENT", "COMMUNITY", "KIDS", "WORKSHOP", "PERFORMANCE"] },
        "short_description": { "type": "string" },
        "location_name": { "type": "string" },
        "location_address": { "type": "string" },
        "nearest_hub": { "type": "string" },
        "walking_relevance_score": { "type": "number" },
        "start_datetime": { "type": "string", "format": "date-time" },
        "end_datetime": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "registration_required": { "type": "boolean" },
        "event_url": { "type": "string" },
        "image_url": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "node_id": { "type": "string" },
        "is_active": { "type": "boolean" }
      },
      "required": ["source", "source_id", "signal_title", "start_datetime", "end_datetime"]
    }
  },
  "firestore": {
    "/nodes/{nodeId}": {
      "schema": "Node",
      "description": "Collection of physical NFC nodes."
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles and roles."
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Collection of local business partners."
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Active live broadcasts."
    },
    "/taps/{tapId}": {
      "schema": "Tap",
      "description": "NFC tap logs."
    },
    "/vibe_reports/{reportId}": {
      "schema": "VibeReport",
      "description": "User vibe reports."
    },
    "/tab_views/{viewId}": {
      "schema": "TabView",
      "description": "Tab navigation logs."
    },
    "/pois/{poiId}": {
      "schema": "Poi",
      "description": "Public art and landmarks."
    },
    "/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "General user interaction logs."
    },
    "/signals/{signalId}": {
      "schema": "Signal",
      "description": "Database of aggregated civic signals."
    }
  }
}

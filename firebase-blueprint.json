{
  "entities": {
    "Node": {
      "title": "Sector Hub Node",
      "description": "Physical NFC trigger points.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the node" },
        "name": { "type": "string", "description": "Human-readable name of the location" },
        "type": { "type": "string", "enum": ["street", "conference_center"], "description": "Category of the hub" },
        "latitude": { "type": "number", "description": "WGS84 Latitude" },
        "longitude": { "type": "number", "description": "WGS84 Longitude" },
        "radius_limit": { "type": "number", "description": "Radius in meters for broadcasts" }
      },
      "required": ["id", "name", "type", "latitude", "longitude", "radius_limit"]
    },
    "Partner": {
      "title": "Local Partner",
      "description": "Businesses or organizations providing broadcasts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tier": { "type": "string", "enum": ["standard", "premium", "anchor"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "owner_uid": { "type": "string", "description": "Firebase Auth UID of the partner owner" },
        "owner_email": { "type": "string", "description": "Email address of the partner owner" },
        "logo_url": { "type": "string" },
        "brand_color": { "type": "string" },
        "deal_text": { "type": "string" },
        "sponsor_zones": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "tier", "latitude", "longitude"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user data with roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "partner", "user"] },
        "name": { "type": "string" },
        "partner_id": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Broadcast": {
      "title": "Live Broadcast",
      "description": "Deals, events, or sessions currently active.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partner_id": { "type": "string", "description": "Optional partner link" },
        "node_id": { "type": "string", "description": "Node where it was ignited (for flash events)" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["flash_deal", "event", "conference_panel"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "expires_at": { "type": "string", "format": "date-time" },
        "current_vibe": { "type": "string", "enum": ["chill", "buzzing", "packed"] }
      },
      "required": ["id", "title", "type", "latitude", "longitude", "expires_at", "current_vibe"]
    },
    "Tap": {
      "title": "Proof of Presence Tap",
      "description": "Analytics for NFC taps.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "node_id": { "type": "string" },
        "session_uuid": { "type": "string" },
        "tapped_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "node_id", "session_uuid", "tapped_at"]
    },
    "VibeReport": {
      "title": "Crowdsourced Vibe Check",
      "description": "User feedback on event density.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "broadcast_id": { "type": "string" },
        "session_uuid": { "type": "string" },
        "vibe": { "type": "string", "enum": ["chill", "buzzing", "packed"] },
        "reported_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "broadcast_id", "session_uuid", "vibe", "reported_at"]
    }
  },
  "firestore": {
    "/nodes/{nodeId}": {
      "schema": "Node",
      "description": "Collection of physical NFC nodes."
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles and roles."
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Collection of local business partners."
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Active live broadcasts."
    },
    "/taps/{tapId}": {
      "schema": "Tap",
      "description": "NFC tap logs."
    },
    "/vibe_reports/{reportId}": {
      "schema": "VibeReport",
      "description": "User vibe reports."
    }
  }
}

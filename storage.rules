rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sponsors/temp/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /partners/{partnerId}/logo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

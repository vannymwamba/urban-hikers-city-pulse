rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Partner Logos
    match /partner_logos/{partnerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        isAdmin(request.auth) || 
        isPartnerOwner(request.auth.uid, partnerId)
      ) && isValidImage();
    }
    
    // 2. Partners Logo
    match /partners/{partnerId}/logo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        isAdmin(request.auth) || 
        isPartnerOwner(request.auth.uid, partnerId)
      ) && isValidImage();
    }

    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth);
    }

    // 3. Mural Images
    match /mural_images/{muralName}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth) && isValidImage();
    }
  }
}

function isAdmin(auth) {
  // Use email as master override
  return auth.token.email.matches('(?i)^vannymwamba@gmail\\.com$');
}

function isPartnerOwner(uid, partnerId) {
  // Simplified for performance - will be checked via Firestore role in future iterations
  return request.auth.uid == uid;
}

function isValidImage() {
  return request.resource.size < 5 * 1024 * 1024 &&
         request.resource.contentType.matches('image/.*');
}

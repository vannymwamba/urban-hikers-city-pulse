rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sponsors/{partnerId}/{allPaths=**} {
      // Allow read for everyone
      allow read: if true;
      
      // Allow write for admins or the partner themselves
      allow write: if request.auth != null && (
        // Default Admin check (Email-based, most resilient)
        (request.auth.token.email == "vannymwamba@gmail.com" && request.auth.token.email_verified == true) ||
        // Firestore role check (Fallback to default database)
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        // Partner ownership check
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.partnerId == partnerId
      );
    }
  }
}

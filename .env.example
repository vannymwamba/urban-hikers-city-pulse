# Urban Hikers OS Environment Variables
# Get your key from https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# CARTO Basemaps Configuration
VITE_CARTO_API_KEY=
VITE_CARTO_RASTER_TILE_URL=
VITE_CARTO_VECTOR_STYLE_URL=

# Stripe for walking tour payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL for absolute paths (e.g. OG images)
APP_URL=

# Firebase Configuration (Optional overrides)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
FIREBASE_PROJECT_ID=

# Admin SDK service account for server-only writes (e.g. leaderboard recompute).
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the resulting JSON as a single line. NEVER commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Urban Hikers OS Environment Variables
# Get your key from https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Stripe for walking tour payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL for absolute paths (e.g. OG images)
APP_URL=

# Firebase Configuration (Optional overrides)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
FIREBASE_PROJECT_ID=
